  "workflow_request_validation": {
    "_comment": "Direct POST /v1/workflow/full with key and identity, bypassing the gateway (as the evaluator does). NAT itself validates only that the body is JSON with messages or input_message; roles, final-turn and unknown fields are enforced by the gateway alone.",
    "cases": {
      "not json": {
        "status": 422,
        "body": "{\"detail\":[{\"type\":\"json_invalid\",\"loc\":[\"body\",1],\"msg\":\"JSON decode error\",\"input\":{},\"ctx\":{\"error\":\"Expecting property name enclosed in double quotes\"}}]}"
      },
      "empty object": {
        "status": 422,
        "body": "{\"detail\":[{\"type\":\"value_error\",\"loc\":[\"body\"],\"msg\":\"Value error, Either messages or input_message must be provided\",\"input\":{},\"ctx\":{\"error\":{}}}]}"
      },
      "empty messages": {
        "status": 200,
        "non_step_frames": [
          "{\"code\":\"workflow_error\",\"message\":\"No input received in state: \\\"messages\\\"\",\"details\":\"RuntimeError\"}"
        ]
      },
      "system role": {
        "status": 200,
        "non_step_frames": [
          "data: {\"value\": \"CSPX-LSE: the deterministic engine decided \"}",
          "data: {\"value\": \"shortlist\"}",
          "... 11 more answer frames"
        ]
      },
      "tool role": {
        "status": 200,
        "non_step_frames": [
          "{\"code\":\"workflow_error\",\"message\":\"'tool_call_id'\",\"details\":\"KeyError\"}"
        ]
      },
      "last turn assistant": {
        "status": 200,
        "non_step_frames": [
          "data: {\"value\": \"CSPX-LSE: the deterministic engine decided \"}",
          "data: {\"value\": \"shortlist\"}",
          "... 11 more answer frames"
        ]
      },
      "unknown top-level field": {
        "status": 200,
        "non_step_frames": [
          "data: {\"value\": \"CSPX-LSE: the deterministic engine decided \"}",
          "data: {\"value\": \"shortlist\"}",
          "... 11 more answer frames"
        ]
      },
      "empty content": {
        "status": 200,
        "non_step_frames": []
      }
    }
  }
