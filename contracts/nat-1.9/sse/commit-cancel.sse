data: {"event_type":"interaction_required","execution_id":"326c79d5-d6cb-4c87-82d5-b486d933f5ae","interaction_id":"80a4caba-fc13-4217-a0b8-ee9442bbd77e","prompt":{"text":"ETF: VJPN-LSE\nAction: commit review decision\nDeterministic engine (authoritative): research\nDefault decision: research\nSummary: Recorded for the NAT freeze corpus.\nConfirm the deterministic decision, or choose a different one. Any change is an explicit human override and requires a rationale.\nThis records a research decision only. Nothing is bought, sold or held.","timeout":null,"error":"This prompt is no longer available.","options":[{"id":"reject","label":"Override — reject","value":"reject","description":"Requires a rationale, recorded against your identity."},{"id":"research","label":"Confirm — research","value":"research","description":"The deterministic engine's decision. Applied with no override."},{"id":"shortlist","label":"Override — shortlist","value":"shortlist","description":"Requires a rationale, and a grounded research note — no note has been drafted yet, so you will be asked for one."},{"id":"cancel","label":"Cancel","value":"__CANCEL__","description":"Change nothing."}],"input_type":"radio"},"response_url":"/executions/326c79d5-d6cb-4c87-82d5-b486d933f5ae/interactions/80a4caba-fc13-4217-a0b8-ee9442bbd77e/response"}

